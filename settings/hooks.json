{
  "_comment": "Merged into ~/.claude/settings.json by install.sh (hooks + permissions)",
  "permissions": {
    "allow": [
      "Bash(git -C:*)",
      "Bash(npm --prefix:*)",
      "Bash(pnpm --prefix:*)",
      "Bash(npx --prefix:*)"
    ]
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "~/.trimkit/bin/trimkit-update-check",
            "statusMessage": "Checking for trimkit updates..."
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/no-chaining.sh",
            "statusMessage": "Checking for command chaining..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/prod-debug.sh",
            "statusMessage": "Checking for prod-debug updates..."
          }
        ]
      }
    ]
  }
}
